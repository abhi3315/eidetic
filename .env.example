# Copy to .env and adjust as needed.
# Eidetic reads these on startup — no config file required.

# SQLite database file (created on first run; no server process involved)
# Defaults to ~/.cache/eidetic/eidetic.db if unset
# EIDETIC_DATABASE_PATH=/your/eidetic.db

# Where imported files are stored (content-addressable layout)
# Defaults to ~/.cache/eidetic/library if unset
# EIDETIC_LIBRARY_DIR=/your/photo/library

# Where ML model files are cached (~350 MB on first embed run)
# Defaults to ~/.cache/eidetic/models if unset
# EIDETIC_MODELS_CACHE=/your/models/cache

# ONNX Runtime execution provider: cpu (default), cuda, or coreml.
# `cuda` requires a build with --features cuda plus an ONNX Runtime >= 1.27
# CUDA build at runtime (see docs/adr/0006-gpu-execution-provider.md).
# EIDETIC_ACCELERATOR=cuda

# Log level (trace, debug, info, warn, error)
# EIDETIC_LOG=info
